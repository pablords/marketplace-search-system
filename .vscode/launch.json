        {
            "type": "debugpy",
            "name": "🤖 ML Embedding Service",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host",
                "0.0.0.0",
                "--port",
                "8085"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/ml-embedding-service",
            "python": "${workspaceFolder}/.venv/bin/python",
            "justMyCode": false
