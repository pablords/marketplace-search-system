{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "📦 Catalog Service",
            "request": "launch",
            "mainClass": "com.marketplace.search.catalog.bootstrap.CatalogApp",
            "args": ["--spring.profiles.active=development"],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Dspring.output.ansi.enabled=always",
                "-Xmx1G",
                "-XX:+UseG1GC"
            ],
            "envFile": "${workspaceFolder}/catalog-service/.env.dev",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/catalog-service/bootstrap",
            "preLaunchTask": "RUN_CATALOG_SERVICE"
        },
        {
            "type": "java",
            "name": "🔍 Indexing Service",
            "request": "launch",
            "mainClass": "com.marketplace.search.indexing.bootstrap.IndexingApp",
            "args": [
                "--spring.profiles.active=development"
            ],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Dspring.output.ansi.enabled=always",
                "-Xmx1G",
                "-XX:+UseG1GC"
            ],
            "envFile": "${workspaceFolder}/indexing-service/.env.dev",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/indexing-service/bootstrap",
            "preLaunchTask": "RUN_INDEXING_SERVICE"
        },
        {
            "type": "java",
            "name": "🔎 Search Service",
            "request": "launch",
            "mainClass": "com.marketplace.search.search.bootstrap.SearchApp",
            "args": ["--spring.profiles.active=development"],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Dspring.output.ansi.enabled=always",
                "-Xmx1G",
                "-XX:+UseG1GC"
            ],
            "envFile": "${workspaceFolder}/search-service/.env.dev",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/search-service/bootstrap",
            "preLaunchTask": "RUN_SEARCH_SERVICE"
        },
        {
            "name": "🤖 ML Embedding Service",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "/bin/bash",
            "envFile": "${workspaceFolder}/ml-embedding-service/.env.dev",
            "runtimeArgs": [
                "-c",
                "cd '${workspaceFolder}/ml-embedding-service' && bash run.sh"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "node",
            "name": "📊 ML Ranking Service",
            "request": "launch",
            "runtimeExecutable": "/bin/bash",
            "envFile": "${workspaceFolder}/ml-ranking-service/.env.dev",
            "runtimeArgs": [
                "-c",
                "cd '${workspaceFolder}/ml-ranking-service' && bash run.sh"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "type": "go",
            "name": "🚪 API Gateway",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/api-gateway/cmd/gateway",
            "args": [
                "--config=${workspaceFolder}/api-gateway/configs/config.development.yaml"
            ],
            "envFile": "${workspaceFolder}/api-gateway/.env.dev",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/api-gateway",
            "preLaunchTask": "GO_BUILD_API_GATEWAY",
            "showLog": true
        }
    ]
}
