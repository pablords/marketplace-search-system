{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "🚪 API Gateway",
            "request": "launch",
            "mainClass": "com.marketplace.search.gateway.bootstrap.GatewayApp",
            "args": ["--spring.profiles.active=development"],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Dspring.output.ansi.enabled=always",
                "-Xmx1G",
                "-XX:+UseG1GC"
            ],
            "envFile": "${workspaceFolder}/api-gateway/.env",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "cwd": "${workspaceFolder}/api-gateway/bootstrap",
            "preLaunchTask": "maven: compile api-gateway",
            "noDebug": true
        },
        {
            "type": "java",
            "name": "🐛 Debug - API Gateway",
            "request": "launch",
            "mainClass": "com.marketplace.search.gateway.bootstrap.GatewayApp",
            "args": [
                "--spring.profiles.active=development",
                "--debug"
            ],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Dspring.output.ansi.enabled=always",
