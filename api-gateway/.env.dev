ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVER_PORT=8080
# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=1.0.0
OTEL_RESOURCE_ATTRIBUTES=service.name=api-gateway,service.version=1.0.0
# Catalog Service Configuration
CATALOG_SERVICE_BASE_URL=http://localhost:8081/api/v1
CATALOG_SERVICE_TIMEOUT=5000
CATALOG_SERVICE_RETRY_MAX_ATTEMPTS=3
CATALOG_SERVICE_RETRY_MIN_BACKOFF=500
CATALOG_SERVICE_CB_FAILURE_RATE_THRESHOLD=50
CATALOG_SERVICE_CB_WAIT_DURATION=10000
CATALOG_SERVICE_CB_SLIDING_WINDOW_SIZE=10
# Search Service Configuration
SEARCH_SERVICE_BASE_URL=http://localhost:8086/api/v1
SEARCH_SERVICE_TIMEOUT=3000
SEARCH_SERVICE_RETRY_MAX_ATTEMPTS=3
SEARCH_SERVICE_RETRY_MIN_BACKOFF=500
SEARCH_SERVICE_CB_FAILURE_RATE_THRESHOLD=50
SEARCH_SERVICE_CB_WAIT_DURATION=10000
SEARCH_SERVICE_CB_SLIDING_WINDOW_SIZE=10