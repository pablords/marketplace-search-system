<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Filter para excluir requests do actuator dos logs -->
    <turboFilter class="ch.qos.logback.classic.turbo.MDCFilter">
        <MDCKey>http.target</MDCKey>
        <Value>/actuator</Value>
        <OnMatch>DENY</OnMatch>
    </turboFilter>

    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSZ</timestampPattern>
            
            <!-- Incluir apenas campos essenciais -->
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <logger>[ignore]</logger>
                <thread>[ignore]</thread>
                <level>level</level>
                <levelValue>[ignore]</levelValue>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>

            <!-- Incluir trace_id e span_id do OTel Javaagent MDC -->
            <includeMdcKeyName>trace_id</includeMdcKeyName>
            <includeMdcKeyName>span_id</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- Silenciar logs de actuator/prometheus do Spring -->
    <logger name="org.springframework.boot.actuate" level="WARN"/>
    <logger name="org.springframework.web.servlet.DispatcherServlet" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE_JSON" />
    </root>

</configuration>
