# Variáveis de ambiente para desenvolvimento local

# Banco de dados PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace_search
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_PRODUCTS_INDEX=products-index

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=
KAFKA_PRODUCT_EVENTS_TOPIC=product-events



# Aplicação
SPRING_PROFILES_ACTIVE=development
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_MARKETPLACE_SEARCH=DEBUG

# Monitoring
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# JWT (para autenticação futura)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRATION=86400000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=10000

# Search
SEARCH_MAX_RESULTS=100
SEARCH_DEFAULT_PAGE_SIZE=20

# Timeouts
HTTP_CLIENT_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=30000
ELASTICSEARCH_TIMEOUT=10000