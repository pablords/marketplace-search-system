{
  "java.compile.nullAnalysis.mode": "automatic",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.autobuild.enabled": true,
  "spring-boot.live-reload.enabled": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "java.saveActions.organizeImports": true,
  "java.format.enabled": true,
  "java.import.maven.enabled": true,
  "maven.executable.path": "mvn",
  "maven.terminal.useJavaHome": true,
  "java.maven.downloadSources": true,
  "java.maven.downloadJavadoc": true,
  "java.codeGeneration.insertionLocation": "afterCursor",
  "java.codeGeneration.generateComments": true,
  "java.completion.enabled": true,
  "java.completion.importOrder": [
    "java",
    "javax",
    "org",
    "com"
  ],
  "python.defaultInterpreterPath": "./notebooks/venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "jupyter.notebookFileRoot": "${workspaceFolder}/notebooks",
  "jupyter.interactiveWindow.creationMode": "perFile",
  "jupyter.interactiveWindow.textEditor.executeSelection": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "notebook.output.textLineLimit": 30,
  "jupyter.askForKernelRestart": false,
  "jupyter.jupyterServerType": "local",
  "files.associations": {
    "*.ipynb": "jupyter-notebook"
  },
  "jupyter.kernels.excludePythonEnvironments": [
    "./notebooks/venv/bin/python"
  ]
}